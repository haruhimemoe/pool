{
  "name": "@haruhimemoe/pool",
  "version": "0.1.0",
  "description": "osu! tournament mappools as data: slots, mod buckets, custom slots with forced or free mods, zod validation, pure editing helpers, pasted-pool parsing, and the pk1/pk2/pk3 pack key codec.",
  "keywords": [
    "osu",
    "osu!",
    "tournament",
    "mappool",
    "pool",
    "beatmap",
    "pack key",
    "zod"
  ],
  "homepage": "https://github.com/haruhimemoe/pool#readme",
  "bugs": "https://github.com/haruhimemoe/pool/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/pool.git"
  },
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:dist": "bun run build && node scripts/smoke.mjs",
    "prepublishOnly": "bun run check && bun run typecheck && bun run test && bun run test:dist",
    "check:consumer": "bun run build && node scripts/check-consumer.mjs"
  },
  "peerDependencies": {
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
